# --- Secrets: never commit these ---
.env
# firebase-service-account.json is kept here after the Firebase retirement
# (2026-08) purely as a guard: the file is gone, but an old copy resurfacing
# in a working tree must still never be committed.
**/firebase-service-account.json

# --- Machine-local TLS artifact ---
# Regenerated by tls_fix.configure() from this machine's Windows cert store
# (certifi roots + the AV root). Public certs, no private keys, but it is
# machine-specific and 384 KB — it does not belong in the repo.
backend_python/.ca_bundle.pem

# --- Offline corpus ---
# Real employee records. Local-only by design, and NOT regenerable: it
# stopped being a Firestore export long before Firebase was retired, and
# export_firestore.py is deleted. This directory is the source the Supabase
# loader reads, so the copy on disk is the only copy — back it up locally.
backend_python/mock_data/
# Dated local backups of the above (mock_data_backup_YYYYMMDD_HHMMSS/).
# Same real records, so the same rule applies.
backend_python/mock_data_backup_*/

# --- Golden API responses ---
# Recorded responses used to prove the Supabase migration did not change
# any response shape. Same employee records as mock_data/, so same rule;
# regenerate with `python golden_capture.py capture`.
# The glob also covers the dated backups taken before a re-baseline
# (golden_pre_supabase_YYYYMMDD/), which hold the same real records.
backend_python/golden*/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Flutter / Dart ---
scheduling_system/build/
# Compiled installer; keep installer.iss as the versioned build recipe.
scheduling_system/installer/
# Gradle writes android/build/ too, which the Flutter .gitignore's
# root-anchored /build/ rule does not catch.
scheduling_system/**/build/
scheduling_system/.dart_tool/
scheduling_system/.flutter-plugins
scheduling_system/.flutter-plugins-dependencies
**/generated_plugin_registrant.dart

# --- Editors / OS ---
.idea/
.vscode/ 
Thumbs.db
.DS_Store
